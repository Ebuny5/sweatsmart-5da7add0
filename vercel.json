{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://ujbcolxawpzfjkjviwqw.supabase.co/:match*"
    },
    {
      "source": "/((?!\\.well-known/|api/|assets/|.*\\.).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(index.html|sw.js|manifest.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
